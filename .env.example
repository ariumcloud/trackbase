# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - TRACKBASE
# ==============================================================================

# 1. URL da Aplicação
# URL pública do Trackbase (sem barra no final)
# Local: http://localhost:3000 | Produção: https://app.trackbase.com
APP_URL=http://localhost:3000

# 2. Supabase (Banco de Dados, Autenticação e RLS)
# Copie do painel do Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# 3. Chave de Criptografia AES-256-GCM
# Chave de 32 bytes em Base64 para criptografar tokens sensíveis no banco.
# Gere uma chave com o comando: openssl rand -base64 32
ENCRYPTION_KEY=

# 4. Cron Job / Tarefas Agendadas
# Segredo para autenticar requisições na rota /api/cron/sync
CRON_SECRET=um_segredo_forte_para_cron

# 5. Meta Ads / Facebook Marketing API (Opcional - para OAuth da Meta)
# Obtenha em: https://developers.facebook.com > Seu App > Configurações Básicas
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# 6. Assistente IA (somente servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 7. Google Ads (opcional — OAuth e verificação de contas)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=

# 8. Push notifications (opcional)
# Gere um par VAPID próprio; a chave pública pode usar NEXT_PUBLIC_, a privada nunca.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@example.com
